<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:id="@+id/btnBack"
                android:text="←"
                android:textColor="#E53935"
                android:textSize="24sp"
                android:layout_marginEnd="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvScreenTitle"
                android:text="Crear Evento"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView android:text="NOMBRE DEL EVENTO" android:textSize="10sp"
            android:textColor="#888892" android:letterSpacing="0.15"
            android:layout_marginBottom="6dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etTitle"
            android:hint="Ej: Vemos el partido en casa"
            android:textColor="#FFFFFF" android:textColorHint="#555560"
            android:background="@drawable/bg_input" android:padding="14dp"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginBottom="16dp"/>

        <TextView android:text="DEPORTE" android:textSize="10sp"
            android:textColor="#888892" android:letterSpacing="0.15"
            android:layout_marginBottom="6dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <Spinner android:id="@+id/spinnerSport"
            android:background="@drawable/bg_input"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:entries="@array/sports_array"/>

        <TextView android:text="PARTIDO / COMBATE" android:textSize="10sp"
            android:textColor="#888892" android:letterSpacing="0.15"
            android:layout_marginBottom="6dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etMatch"
            android:hint="Ej: México vs Argentina - Mundial 2026"
            android:textColor="#FFFFFF" android:textColorHint="#555560"
            android:background="@drawable/bg_input" android:padding="14dp"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginBottom="16dp"/>

        <TextView android:text="FECHA Y HORA" android:textSize="10sp"
            android:textColor="#888892" android:letterSpacing="0.15"
            android:layout_marginBottom="6dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etDate"
            android:hint="Ej: 15 Jun 2026 · 18:00"
            android:textColor="#FFFFFF" android:textColorHint="#555560"
            android:background="@drawable/bg_input" android:padding="14dp"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginBottom="20dp"/>

        <!-- A. CUPO MÁXIMO con slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView android:text="A. CUPO MÁXIMO (Invitados)" android:textSize="11sp"
                    android:textColor="#888892" android:letterSpacing="0.1"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvCupoValue" android:text="15"
                    android:textSize="28sp" android:textColor="#E53935" android:textStyle="bold"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <SeekBar android:id="@+id/sbCupo"
                android:min="5" android:max="30" android:progress="15"
                android:progressTint="#E53935" android:thumbTint="#FF6B5E"
                android:layout_marginTop="4dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- B. TIPO DE ESPACIO (pickers) -->
        <TextView android:text="B. TIPO DE ESPACIO" android:textSize="11sp"
            android:textColor="#888892" android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <LinearLayout android:id="@+id/cardHome"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_picker_selected"
                android:padding="14dp" android:layout_marginEnd="8dp">
                <TextView android:text="🏠" android:textSize="24sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Hogar / Depto" android:textColor="#FFFFFF" android:textSize="11sp"
                    android:gravity="center" android:layout_marginTop="4dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardBiz"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_picker"
                android:padding="14dp" android:layout_marginEnd="8dp">
                <TextView android:text="🏪" android:textSize="24sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Establecimiento" android:textColor="#AAAAAA" android:textSize="11sp"
                    android:gravity="center" android:layout_marginTop="4dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/cardSport"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_picker"
                android:padding="14dp">
                <TextView android:text="🏟️" android:textSize="24sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="Espacio Deportivo" android:textColor="#AAAAAA" android:textSize="11sp"
                    android:gravity="center" android:layout_marginTop="4dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- C. UBICACIÓN -->
        <TextView android:text="C. UBICACIÓN (COLONIA)" android:textSize="11sp"
            android:textColor="#888892" android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etLocation"
            android:hint="Ej: Col. Roma Norte, CDMX"
            android:textColor="#FFFFFF" android:textColorHint="#555560"
            android:background="@drawable/bg_input" android:padding="14dp"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginBottom="28dp"/>

        <TextView android:text="D. APORTE / CUOTA" android:textSize="11sp"
            android:textColor="#888892" android:letterSpacing="0.1"
            android:layout_marginBottom="6dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <EditText android:id="@+id/etFee"
            android:hint="Ej: Gratis · Lleva botana 🍿 · Coopera $50"
            android:textColor="#FFFFFF" android:textColorHint="#555560"
            android:background="@drawable/bg_input" android:padding="14dp"
            android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginBottom="28dp"/>

        <Button android:id="@+id/btnCreate"
            android:text="CREAR EVENTO Y TRANSMITIR LIVE 🔴"
            android:textColor="#FFFFFF" android:textStyle="bold"
            android:background="@drawable/bg_button"
            android:layout_width="match_parent" android:layout_height="60dp"
            android:layout_marginBottom="20dp"/>
    </LinearLayout>
</ScrollView>
