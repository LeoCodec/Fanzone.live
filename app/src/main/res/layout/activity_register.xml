<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0A0A0A" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="30dp" android:paddingEnd="30dp"
        android:paddingTop="32dp" android:paddingBottom="32dp">

        <TextView android:id="@+id/btnBack" android:text="&#8592; Volver"
            android:textColor="#E53935" android:textSize="14sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"/>

        <TextView android:text="&#128221;" android:textSize="48sp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"/>

        <TextView android:text="Crear cuenta" android:textSize="26sp"
            android:textColor="#FFFFFF" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"/>
        <TextView android:text="Unete a la comunidad y arma tu primer encuentro."
            android:textSize="13sp" android:textColor="#9A9AA5"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"/>

        <TextView android:text="CORREO ELECTRONICO" android:textSize="9sp"
            android:textColor="#888888" android:letterSpacing="0.15" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etEmail" android:hint="tu@correo.com"
            android:textColor="#FFFFFF" android:textColorHint="#5A5A62"
            android:background="@drawable/bg_input" android:padding="16dp"
            android:inputType="textEmailAddress"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginBottom="16dp"/>

        <TextView android:text="CONTRASENA" android:textSize="9sp" android:textColor="#888888"
            android:letterSpacing="0.15" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"/>
        <EditText android:id="@+id/etPassword"
            android:hint="&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;"
            android:textColor="#FFFFFF" android:textColorHint="#5A5A62"
            android:background="@drawable/bg_input" android:padding="16dp"
            android:inputType="textPassword"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginBottom="28dp"/>

        <Button android:id="@+id/btnRegister" android:text="REGISTRARME"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"
            android:background="@drawable/bg_button"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginBottom="22dp"/>

        <TextView android:id="@+id/tvLogin"
            android:text="&#191;Ya tienes cuenta? Inicia sesion"
            android:textColor="#E53935" android:textSize="13sp" android:textStyle="bold"
            android:gravity="center" android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>