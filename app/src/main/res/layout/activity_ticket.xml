<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A0C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="#141418">

        <TextView android:id="@+id/btnBack" android:text="←"
            android:textColor="#E53935" android:textSize="24sp"
            android:layout_marginEnd="12dp"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <TextView android:text="Mi Entrada 🎟️"
            android:textSize="20sp" android:textColor="#FFFFFF" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_ticket"
                android:padding="24dp">

                <TextView android:text="FANZONE LIVE"
                    android:textColor="#E53935" android:textSize="14sp" android:textStyle="bold"
                    android:letterSpacing="0.2" android:layout_marginBottom="4dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                <TextView android:id="@+id/tvTicketTitle" android:text="México vs Brasil"
                    android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"
                    android:gravity="center" android:layout_marginBottom="16dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                <ImageView android:id="@+id/ivQr"
                    android:layout_width="240dp" android:layout_height="240dp"
                    android:background="#FFFFFF" android:padding="10dp"
                    android:layout_marginBottom="16dp"/>

                <TextView android:text="✅ ACCESO ACEPTADO"
                    android:textColor="#4CAF50" android:textSize="14sp" android:textStyle="bold"
                    android:layout_marginBottom="16dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:background="#33222A" android:layout_marginBottom="12dp"/>

                <TextView android:id="@+id/tvTicketDate" android:text="📅 15 Jun · 18:00"
                    android:textColor="#CCCCCC" android:textSize="14sp" android:layout_marginBottom="4dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvTicketLocation" android:text="📍 Col. Roma, CDMX"
                    android:textColor="#CCCCCC" android:textSize="14sp" android:layout_marginBottom="4dp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvUserId" android:text="ID: XXXXXXXX"
                    android:textColor="#777" android:textSize="12sp"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <TextView android:text="Muestra este código al anfitrión para confirmar tu asistencia."
                android:textColor="#888892" android:textSize="12sp" android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
